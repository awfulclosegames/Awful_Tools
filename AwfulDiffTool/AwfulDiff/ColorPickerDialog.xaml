<Window x:Class="AwfulDiff.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick Colour"
        Width="320"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource UiFont}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom title bar (matches SettingsDialog chrome) -->
            <RowDefinition Height="Auto"/>
            <!-- Dialog content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Outer glow frame, same as other dialogs -->
        <Border BorderBrush="{DynamicResource BorderGlowDim}" BorderThickness="1"/>

        <Border Grid.Row="0"
                Background="{DynamicResource BgToolbar}"
                BorderBrush="{DynamicResource BorderGlow}"
                BorderThickness="0,0,0,1"
                Height="32"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◈"
                               Foreground="{DynamicResource TextAccent}"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="8,0,4,0"/>
                    <TextBlock Text="Pick Colour"
                               Foreground="{DynamicResource TextAccent}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Close button -->
                <Button Grid.Column="1"
                        Style="{DynamicResource WindowControlCloseButton}"
                        Content="x"
                        Click="Cancel_Click"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="16">
            <!-- Live preview -->
            <Border x:Name="PreviewBox"
                    Height="28"
                    CornerRadius="2"
                    BorderBrush="{DynamicResource BorderGlow}"
                    BorderThickness="1"/>

            <!-- Hex input (strict #RRGGBB / #AARRGGBB) -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Hex"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" x:Name="HexBox"
                         VerticalAlignment="Center"
                         FontSize="12"
                         FontFamily="Consolas"
                         TextChanged="HexBox_TextChanged"/>
            </Grid>

            <!-- R/G/B sliders -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="R" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                <Slider Grid.Column="1" x:Name="SlR" Minimum="0" Maximum="255"
                        VerticalAlignment="Center" ValueChanged="Channel_ValueChanged"/>
                <TextBlock Grid.Column="2" x:Name="ValR" Text="0" Width="28"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0"/>
            </Grid>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="G" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                <Slider Grid.Column="1" x:Name="SlG" Minimum="0" Maximum="255"
                        VerticalAlignment="Center" ValueChanged="Channel_ValueChanged"/>
                <TextBlock Grid.Column="2" x:Name="ValG" Text="0" Width="28"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0"/>
            </Grid>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="B" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                <Slider Grid.Column="1" x:Name="SlB" Minimum="0" Maximum="255"
                        VerticalAlignment="Center" ValueChanged="Channel_ValueChanged"/>
                <TextBlock Grid.Column="2" x:Name="ValB" Text="0" Width="28"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0"/>
            </Grid>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="OK" Style="{DynamicResource DialogButtonStyle}" Click="Ok_Click" Width="80" Margin="0,0,8,0" IsDefault="True"/>
                <Button Content="Cancel" Style="{DynamicResource DialogButtonStyle}" Click="Cancel_Click" Width="80"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
