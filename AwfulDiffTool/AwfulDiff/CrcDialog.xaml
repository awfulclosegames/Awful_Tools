<Window x:Class="AwfulDiff.CrcDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CRC-32"
        Width="340"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource UiFont}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom title bar (matches other dialogs' chrome) -->
            <RowDefinition Height="Auto"/>
            <!-- Dialog content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Outer glow frame, same as other dialogs -->
        <Border BorderBrush="{DynamicResource BorderGlowDim}" BorderThickness="1"/>

        <Border Grid.Row="0"
                Background="{DynamicResource BgToolbar}"
                BorderBrush="{DynamicResource BorderGlow}"
                BorderThickness="0,0,0,1"
                Height="32"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◈"
                               Foreground="{DynamicResource TextAccent}"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="8,0,4,0"/>
                    <TextBlock Text="CRC-32"
                               Foreground="{DynamicResource TextAccent}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Close button -->
                <Button Grid.Column="1"
                        Style="{DynamicResource WindowControlCloseButton}"
                        Content="x"
                        Click="Close_Click"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="16">
            <!-- Range covered by the checksum -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Range"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" x:Name="RangeText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontFamily="Consolas"/>
            </Grid>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Length"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" x:Name="LengthText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontFamily="Consolas"/>
            </Grid>

            <!-- The checksum itself — read-only but selectable (native Ctrl+C works too) -->
            <TextBox x:Name="HexBox"
                     Margin="0,12,0,0"
                     IsReadOnly="True"
                     FontSize="18"
                     FontWeight="Bold"
                     FontFamily="Consolas"/>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Decimal"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" x:Name="DecimalText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontFamily="Consolas"/>
            </Grid>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CopyBtn" Content="Copy"
                        Style="{DynamicResource DialogButtonStyle}"
                        Click="Copy_Click" Width="80" Margin="0,0,8,0" IsDefault="True"/>
                <Button Content="Close"
                        Style="{DynamicResource DialogButtonStyle}"
                        Click="Close_Click" Width="80"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
