<Window x:Class="AwfulDiff.MergeSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="3-Way Merge"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        MinHeight="310"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource UiFont}">

    <!-- WindowChrome gives the borderless window proper resize hit-areas on all edges and
         corners (without it, WPF only allows grabbing the bottom-right corner). CaptionHeight
         is 0 because the custom title bar handles its own drag logic. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="5"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom title bar (matches MainWindow chrome) -->
            <RowDefinition Height="Auto"/>
            <!-- Dialog content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Outer glow frame, same as main window -->
        <Border BorderBrush="{DynamicResource BorderGlowDim}" BorderThickness="1"/>

        <Border Grid.Row="0"
                Background="{DynamicResource BgToolbar}"
                BorderBrush="{DynamicResource BorderGlow}"
                BorderThickness="0,0,0,1"
                Height="32"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◈"
                               Foreground="{DynamicResource TextAccent}"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="8,0,4,0"/>
                    <TextBlock Text="3-Way Merge"
                               Foreground="{DynamicResource TextAccent}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Close button. IsHitTestVisibleInChrome keeps it clickable —
                     otherwise the top/right resize bands would swallow presses on it. -->
                <Button Grid.Column="1"
                        Style="{DynamicResource WindowControlCloseButton}"
                        Content="x"
                        Click="BtnClose_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="16">

            <TextBlock Text="Pick the base file and the two files with changes. Each change file is diffed against the base; non-conflicting changes merge automatically, conflicting regions must be resolved. You can also drag files from Explorer onto a row."
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <!-- Base file row (drop target) -->
            <Border x:Name="RowBase" Tag="Base" Margin="0,0,0,8" Padding="4"
                    BorderThickness="1" BorderBrush="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Base:" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextAccent}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtBase" Grid.Column="1"
                             IsReadOnly="True"
                             Background="{DynamicResource BgSurface}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource BorderGlowDim}"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="6,2"
                             TextChanged="PathBox_TextChanged"/>
                    <Button Grid.Column="2" Content="Browse…" Style="{DynamicResource DialogButtonStyle}"
                            Margin="8,0,0,0" Width="70" Click="Browse_Click" Tag="Base"/>
                </Grid>
            </Border>

            <!-- File A row (drop target) -->
            <Border x:Name="RowA" Tag="A" Margin="0,0,0,8" Padding="4"
                    BorderThickness="1" BorderBrush="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="File A:" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource MergeChangeABorder}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtA" Grid.Column="1"
                             IsReadOnly="True"
                             Background="{DynamicResource BgSurface}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource BorderGlowDim}"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="6,2"
                             TextChanged="PathBox_TextChanged"/>
                    <Button Grid.Column="2" Content="Browse…" Style="{DynamicResource DialogButtonStyle}"
                            Margin="8,0,0,0" Width="70" Click="Browse_Click" Tag="A"/>
                </Grid>
            </Border>

            <!-- File B row (drop target) -->
            <Border x:Name="RowB" Tag="B" Margin="0,0,0,12" Padding="4"
                    BorderThickness="1" BorderBrush="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="File B:" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource MergeChangeBBorder}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtB" Grid.Column="1"
                             IsReadOnly="True"
                             Background="{DynamicResource BgSurface}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource BorderGlowDim}"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="6,2"
                             TextChanged="PathBox_TextChanged"/>
                    <Button Grid.Column="2" Content="Browse…" Style="{DynamicResource DialogButtonStyle}"
                            Margin="8,0,0,0" Width="70" Click="Browse_Click" Tag="B"/>
                </Grid>
            </Border>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="BtnOk" Content="Merge" Style="{DynamicResource DialogButtonStyle}"
                        Click="Ok_Click" Width="80" Margin="0,0,8,0" IsDefault="True"/>
                <Button Content="Cancel" Style="{DynamicResource DialogButtonStyle}" Click="Cancel_Click" Width="80"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
