<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== SYSTEM LIGHT THEME ===== -->
    <!-- Standard Windows light app colors -->

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BgDeep" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="BgSurface" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="BgPanel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgToolbar" Color="#F0F0F0"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderGlow" Color="#3A6EA5"/>
    <SolidColorBrush x:Key="BorderGlowDim" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#E0E0E0"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="AccentSecondary" Color="#6B3FA0"/>
    <SolidColorBrush x:Key="AccentTertiary" Color="#2D8C4A"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextPrimary" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#555555"/>
    <SolidColorBrush x:Key="TextDim" Color="#888888"/>
    <SolidColorBrush x:Key="TextAccent" Color="#0066D6"/>

    <!-- Diff Highlight Colors (for legend) -->
    <SolidColorBrush x:Key="DiffAddedBg" Color="#20008000"/>
    <SolidColorBrush x:Key="DiffAddedBorder" Color="#40C040"/>
    <SolidColorBrush x:Key="DiffRemovedBg" Color="#20DC3545"/>
    <SolidColorBrush x:Key="DiffRemovedBorder" Color="#E05050"/>
    <SolidColorBrush x:Key="DiffModifiedBg" Color="#20CCA040"/>
    <SolidColorBrush x:Key="DiffModifiedBorder" Color="#D0A050"/>

    <!-- 3-way merge colors (for legend) -->
    <SolidColorBrush x:Key="MergeChangeABg" Color="#30264F78"/>
    <SolidColorBrush x:Key="MergeChangeABorder" Color="#3FA9F5"/>
    <SolidColorBrush x:Key="MergeChangeBBg" Color="#30008000"/>
    <SolidColorBrush x:Key="MergeChangeBBorder" Color="#60D060"/>
    <SolidColorBrush x:Key="MergeConflictBg" Color="#308B5CF6"/>
    <SolidColorBrush x:Key="MergeConflictBorder" Color="#A371F7"/>
    <SolidColorBrush x:Key="MergeConflictResolvedBg" Color="#3040C040"/>
    <SolidColorBrush x:Key="MergeConflictResolvedBorder" Color="#40C040"/>

    <!-- Corner Accent Brushes (subtle for system themes) -->
    <DrawingBrush x:Key="CornerAccentTopLeft" Viewbox="0,0,12,12" ViewboxUnits="Absolute"
                  Stretch="None" AlignmentX="Left" AlignmentY="Top" Opacity="0">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#CCCCCC">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M0,0 L12,0 L12,1 L1,1 L1,12 L0,12 Z"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="CornerAccentTopRight" Viewbox="0,0,12,12" ViewboxUnits="Absolute"
                  Stretch="None" AlignmentX="Right" AlignmentY="Top" Opacity="0">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#CCCCCC">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M0,0 L12,0 L12,1 L12,12 L11,12 L11,1 Z"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="CornerAccentBottomLeft" Viewbox="0,0,12,12" ViewboxUnits="Absolute"
                  Stretch="None" AlignmentX="Left" AlignmentY="Bottom" Opacity="0">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#CCCCCC">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M0,0 L1,0 L1,11 L12,11 L12,12 L0,12 Z"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="CornerAccentBottomRight" Viewbox="0,0,12,12" ViewboxUnits="Absolute"
                  Stretch="None" AlignmentX="Right" AlignmentY="Bottom" Opacity="0">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#CCCCCC">
                <GeometryDrawing.Geometry>
                    <PathGeometry Figures="M0,0 L11,0 L12,0 L12,12 L11,12 L11,1 Z"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- UI Font (Segoe UI for system themes) -->
    <FontFamily x:Key="UiFont">Segoe UI, sans-serif</FontFamily>

    <!-- ===== STYLES ===== -->

    <!-- Toolbar Button - standard light style -->
    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#E8E8E8"/>
        <Setter Property="Foreground" Value="#1E1E1E"/>
        <Setter Property="BorderBrush" Value="#D0D0D0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="2"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#D5E8F7"/>
                            <Setter Property="BorderBrush" Value="#3A6EA5"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#C0D9F0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Layout / view-mode toggle buttons (dimmed when their mode is inactive) -->
    <Style x:Key="LayoutSideBySideButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSideBySide}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LayoutTopBottomButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsTopBottom}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LayoutUnifiedButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
        <Style.Triggers>
            <!-- Dim when not the active layout, or when hex view is on (unified can't render it) -->
            <DataTrigger Binding="{Binding IsUnified}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsHexView}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ViewModeTextButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHexView}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ViewModeHexButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHexView}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Settings button - filled blue, so it stands out from the gray action buttons -->
    <Style x:Key="SettingsButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#2B579A"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#1E3F73"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="2"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#3A6CB5"/>
                            <Setter Property="BorderBrush" Value="#4A80C4"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#24487E"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle CheckBox - standard light style -->
    <Style x:Key="ToggleCheckBoxStyle" TargetType="CheckBox">
        <!-- Themed box/check template lives in Controls.Themed.xaml (shared by all themes) -->
        <Setter Property="Template" Value="{DynamicResource ThemedCheckBoxTemplate}"/>
        <Setter Property="Foreground" Value="#1E1E1E"/>
        <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="4,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#003A70"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Window Control Button -->
    <Style x:Key="WindowControlButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#606060"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E0E0E0"/>
                            <Setter Property="Foreground" Value="#1E1E1E"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#D0D0D0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window Control Close Button -->
    <Style x:Key="WindowControlCloseButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#606060"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#C42B1C"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#991A0E"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu Item Button (dropdown menu items) -->
    <Style x:Key="MenuItemButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E8E8E8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dialog Button - standard light style (settings dialog, preset buttons) -->
    <Style x:Key="DialogButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#E8E8E8"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="#D0D0D0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="2"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#D5E8F7"/>
                            <Setter Property="BorderBrush" Value="#3A6EA5"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#C0D9F0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Radio Button - standard light style (settings dialog) -->
    <Style x:Key="ThemeRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse x:Name="Ring" Fill="Transparent"
                                     Stroke="#B0B0B0" StrokeThickness="1.5"/>
                            <Ellipse x:Name="Dot" Width="6" Height="6"
                                     Fill="{DynamicResource TextAccent}" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextAccent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox - themed dropdown (hex inspector type selector, struct pattern dialog) -->
    <Style x:Key="ThemedComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Background="{DynamicResource BgDeep}"
                                      BorderBrush="{DynamicResource BorderGlowDim}"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"
                                      Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ToggleButtonBorder" CornerRadius="3"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1">
                                        <Polygon HorizontalAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,6,0"
                                                 Fill="{DynamicResource TextAccent}"
                                                 Points="0,0 5,5 10,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ToggleButtonBorder" Property="Background" Value="{DynamicResource BgSurface}"/>
                                            <Setter TargetName="ToggleButtonBorder" Property="BorderBrush" Value="{DynamicResource TextAccent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Margin="4,0,28,0"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <Popup AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Slide">
                            <Grid MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                  SnapsToDevicePixels="True">
                                <Border CornerRadius="3"
                                        Background="{DynamicResource BgDeep}"
                                        BorderBrush="{DynamicResource BorderGlowDim}"
                                        BorderThickness="1"/>
                                <ScrollViewer Margin="2,4,2,2" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    <Setter Property="Padding" Value="4,3"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextAccent}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BgSurface}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
