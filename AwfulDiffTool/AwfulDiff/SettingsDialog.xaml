<Window x:Class="AwfulDiff.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="400"
        Height="280"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource UiFont}">

    <Window.Resources>
        <!-- Colour swatch button: flat rounded rect, background set in code -->
        <Style x:Key="SwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderGlow}"
                                BorderThickness="1"
                                CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom title bar (matches MainWindow chrome) -->
            <RowDefinition Height="Auto"/>
            <!-- Dialog content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Outer glow frame, same as main window -->
        <Border BorderBrush="{DynamicResource BorderGlowDim}" BorderThickness="1"/>

        <Border Grid.Row="0"
                Background="{DynamicResource BgToolbar}"
                BorderBrush="{DynamicResource BorderGlow}"
                BorderThickness="0,0,0,1"
                Height="32"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◈"
                               Foreground="{DynamicResource TextAccent}"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="8,0,4,0"/>
                    <TextBlock Text="Settings"
                               Foreground="{DynamicResource TextAccent}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Close button -->
                <Button Grid.Column="1"
                        Style="{DynamicResource WindowControlCloseButton}"
                        Content="x"
                        Click="BtnClose_Click"/>
            </Grid>
        </Border>

    <StackPanel Grid.Row="1" Margin="16">

        <!-- Theme Selection -->
        <TextBlock Text="Theme"
                   Foreground="{DynamicResource TextAccent}"
                   FontWeight="SemiBold"
                   FontSize="12"
                   Margin="0,0,0,6"/>

        <RadioButton x:Name="RbAwful"
                     GroupName="Theme"
                     Style="{DynamicResource ThemeRadioButtonStyle}"
                     Content="Awful  —  Sci-fi holographic (default)"
                     Checked="ThemeRadio_Checked"
                     Margin="0,2,0,4"/>

        <RadioButton x:Name="RbSystemLight"
                     GroupName="Theme"
                     Style="{DynamicResource ThemeRadioButtonStyle}"
                     Content="System Light  —  Standard Windows light appearance"
                     Checked="ThemeRadio_Checked"
                     Margin="0,2,0,4"/>

        <RadioButton x:Name="RbSystemDark"
                     GroupName="Theme"
                     Style="{DynamicResource ThemeRadioButtonStyle}"
                     Content="System Dark  —  Standard Windows dark appearance"
                     Checked="ThemeRadio_Checked"
                     Margin="0,2,0,12"/>

        <!-- Font Scale -->
        <TextBlock Text="Font Scale"
                   Foreground="{DynamicResource TextAccent}"
                   FontWeight="SemiBold"
                   FontSize="12"
                   Margin="0,4,0,6"/>

        <StackPanel Margin="0,0,0,12">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="50%" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                <Slider Grid.Column="1" x:Name="FontScaleSlider"
                        Minimum="0.5"
                        Maximum="2.0"
                        TickFrequency="0.1"
                        IsSnapToTickEnabled="True"
                        Value="1.0"
                        VerticalAlignment="Center"
                        ValueChanged="FontScaleSlider_ValueChanged"/>
                <TextBlock Grid.Column="2" x:Name="FontScaleValue"
                           Text="100%"
                           Width="40"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="8,0,0,0"/>
            </Grid>
            <StackPanel Orientation="Horizontal">
                <Button Content="75%" Style="{DynamicResource DialogButtonStyle}" Click="PresetScale_Click" Tag="0.75" Width="50" Margin="0,0,4,0"/>
                <Button Content="100%" Style="{DynamicResource DialogButtonStyle}" Click="PresetScale_Click" Tag="1.0" Width="50" Margin="0,0,4,0"/>
                <Button Content="125%" Style="{DynamicResource DialogButtonStyle}" Click="PresetScale_Click" Tag="1.25" Width="50" Margin="0,0,4,0"/>
                <Button Content="150%" Style="{DynamicResource DialogButtonStyle}" Click="PresetScale_Click" Tag="1.5" Width="50" Margin="0,0,4,0"/>
                <Button Content="200%" Style="{DynamicResource DialogButtonStyle}" Click="PresetScale_Click" Tag="2.0" Width="50"/>
            </StackPanel>
        </StackPanel>

        <!-- Diff Engine -->
        <TextBlock Text="Diff Engine"
                   Foreground="{DynamicResource TextAccent}"
                   FontWeight="SemiBold"
                   FontSize="12"
                   Margin="0,4,0,6"/>

        <StackPanel Margin="0,0,0,12">
            <RadioButton x:Name="RbStandardEngine"
                         GroupName="Engine"
                         Style="{DynamicResource ThemeRadioButtonStyle}"
                         Content="Myers  —  O(N+D²), faster"
                         Margin="0,2,0,4"/>
            <RadioButton x:Name="RbPatienceEngine"
                         GroupName="Engine"
                         Style="{DynamicResource ThemeRadioButtonStyle}"
                         Content="Patience  —  anchors on lines unique to both files (default)"
                         Margin="0,2,0,4"/>
        </StackPanel>

        <!-- Syntax Coloring -->
        <TextBlock Text="Syntax Coloring"
                   Foreground="{DynamicResource TextAccent}"
                   FontWeight="SemiBold"
                   FontSize="12"
                   Margin="0,4,0,6"/>

        <CheckBox x:Name="ChkSyntaxColoring"
                  Content="Use Visual Studio-style syntax colours (desaturated)"
                  Foreground="{DynamicResource TextPrimary}"
                  Margin="0,2,0,12"/>

        <!-- Custom Colours (per selected theme) -->
        <TextBlock Text="Custom Colours"
                   Foreground="{DynamicResource TextAccent}"
                   FontWeight="SemiBold"
                   FontSize="12"
                   Margin="0,4,0,2"/>

        <TextBlock Text="Overrides the diff colours for the selected theme. Unticked = theme default."
                   Foreground="{DynamicResource TextSecondary}"
                   FontSize="11"
                   Margin="0,0,0,6"/>

        <StackPanel Margin="0,0,0,12">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="ChkColorAdded" Content="Adds" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimary}"
                          Checked="ColorRow_StateChanged" Unchecked="ColorRow_StateChanged"/>
                <Button Grid.Column="2" x:Name="BtnSwatchAdded" Tag="Added"
                        Style="{StaticResource SwatchStyle}" Click="Swatch_Click"/>
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="ChkColorRemoved" Content="Removes" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimary}"
                          Checked="ColorRow_StateChanged" Unchecked="ColorRow_StateChanged"/>
                <Button Grid.Column="2" x:Name="BtnSwatchRemoved" Tag="Removed"
                        Style="{StaticResource SwatchStyle}" Click="Swatch_Click"/>
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="ChkColorModified" Content="Modifications" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimary}"
                          Checked="ColorRow_StateChanged" Unchecked="ColorRow_StateChanged"/>
                <Button Grid.Column="2" x:Name="BtnSwatchModified" Tag="Modified"
                        Style="{StaticResource SwatchStyle}" Click="Swatch_Click"/>
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="ChkColorMergeCandidates" Content="Merge candidates (A &amp; B)" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimary}"
                          Checked="ColorRow_StateChanged" Unchecked="ColorRow_StateChanged"/>
                <Button Grid.Column="2" x:Name="BtnSwatchMergeCandidates" Tag="MergeCandidates"
                        Style="{StaticResource SwatchStyle}" Click="Swatch_Click"/>
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="ChkColorConflicts" Content="Merge conflicts" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimary}"
                          Checked="ColorRow_StateChanged" Unchecked="ColorRow_StateChanged"/>
                <Button Grid.Column="2" x:Name="BtnSwatchConflicts" Tag="Conflicts"
                        Style="{StaticResource SwatchStyle}" Click="Swatch_Click"/>
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="ChkColorText" Content="Standard text" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimary}"
                          Checked="ColorRow_StateChanged" Unchecked="ColorRow_StateChanged"/>
                <Button Grid.Column="2" x:Name="BtnSwatchText" Tag="Text"
                        Style="{StaticResource SwatchStyle}" Click="Swatch_Click"/>
            </Grid>
        </StackPanel>

        <!-- Buttons: Help left, Apply/Cancel right -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="? Help" HorizontalAlignment="Left"
                    Style="{DynamicResource DialogButtonStyle}" Click="Help_Click" Width="80"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Apply" Style="{DynamicResource DialogButtonStyle}" Click="Apply_Click" Width="80" Margin="0,0,8,0" IsDefault="True"/>
                <Button Content="Cancel" Style="{DynamicResource DialogButtonStyle}" Click="Cancel_Click" Width="80"/>
            </StackPanel>
        </Grid>
    </StackPanel>
    </Grid>
</Window>
