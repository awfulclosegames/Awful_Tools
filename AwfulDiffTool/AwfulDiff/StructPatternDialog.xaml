<Window x:Class="AwfulDiff.StructPatternDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hex Struct Patterns"
        Width="720"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource UiFont}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom title bar (matches other dialogs' chrome) -->
            <RowDefinition Height="Auto"/>
            <!-- Dialog content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Outer glow frame, same as other dialogs -->
        <Border BorderBrush="{DynamicResource BorderGlowDim}" BorderThickness="1"/>

        <Border Grid.Row="0"
                Background="{DynamicResource BgToolbar}"
                BorderBrush="{DynamicResource BorderGlow}"
                BorderThickness="0,0,0,1"
                Height="32"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◈"
                               Foreground="{DynamicResource TextAccent}"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="8,0,4,0"/>
                    <TextBlock Text="Hex Struct Patterns"
                               Foreground="{DynamicResource TextAccent}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Close button -->
                <Button Grid.Column="1"
                        Style="{DynamicResource WindowControlCloseButton}"
                        Content="x"
                        Click="Close_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: saved patterns -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Saved patterns"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,6"/>
                <Button DockPanel.Dock="Bottom"
                        x:Name="NewBtn"
                        Content="＋ New"
                        Style="{DynamicResource DialogButtonStyle}"
                        Click="New_Click"
                        Margin="0,8,0,0"/>
                <ListBox x:Name="PatternList"
                         Background="{DynamicResource BgSurface}"
                         Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource BorderSubtle}"
                         SelectionChanged="PatternList_SelectionChanged"/>
            </DockPanel>

            <!-- Right: pattern editor -->
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Name"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="TxtName"
                             Height="24"
                             VerticalContentAlignment="Center"
                             Background="{DynamicResource BgSurface}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource BorderSubtle}"/>
                    <TextBlock Grid.Column="2" Text="Endianness"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="16,0,8,0"/>
                    <ComboBox Grid.Column="3" x:Name="EndiannessCombo"
                              Style="{DynamicResource ThemedComboBoxStyle}"
                              Width="130" Height="24"
                              SelectedIndex="0">
                        <ComboBoxItem>Little-endian</ComboBoxItem>
                        <ComboBoxItem>Big-endian</ComboBoxItem>
                    </ComboBox>
                </Grid>

                <TextBlock Text="Fields (in memory order)"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,14,0,6"/>

                <ScrollViewer x:Name="FieldsScroll"
                              MaxHeight="270"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FieldsPanel"/>
                </ScrollViewer>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="＋ Add field"
                            Style="{DynamicResource DialogButtonStyle}"
                            Click="AddField_Click"
                            Width="96" Margin="0,0,8,0"/>
                    <Button Content="↑ Up"
                            Style="{DynamicResource DialogButtonStyle}"
                            Click="MoveUp_Click"
                            Width="56" Margin="0,0,8,0"/>
                    <Button Content="↓ Down"
                            Style="{DynamicResource DialogButtonStyle}"
                            Click="MoveDown_Click"
                            Width="64"/>
                </StackPanel>

                <TextBlock x:Name="TotalSizeText"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,8,0,0"/>

                <!-- Bottom bar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Save"
                            Style="{DynamicResource DialogButtonStyle}"
                            Click="Save_Click"
                            Width="80" Margin="0,0,8,0" IsDefault="True"/>
                    <Button Content="Delete"
                            Style="{DynamicResource DialogButtonStyle}"
                            Click="Delete_Click"
                            Width="80" Margin="0,0,8,0"/>
                    <Button Content="Close"
                            Style="{DynamicResource DialogButtonStyle}"
                            Click="Close_Click"
                            Width="80"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
